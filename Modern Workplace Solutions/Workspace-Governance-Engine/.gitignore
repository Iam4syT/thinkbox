# Workspace Governance Engine — .gitignore

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
*.env
*.pfx
*.pem

# ── PowerShell & Output Logs ─────────────────────────────────────────────────
*.log
output/
reports/*.csv

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
