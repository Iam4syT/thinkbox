    "RequireAntivirus": true,
    "MinimumOsVersion": "10.0.19045"
  },
  "DataGovernance": {
    "ExternalSharingAllowed": false,
    "DefaultSharePointLinkType": "InternalPeople",
    "CopilotSemanticIndexGuardrails": "Enabled"
  }
