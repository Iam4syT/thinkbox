# AGY CLI Automation Engine — .gitignore

# ── Python & Virtual Environment ─────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# ── Secrets & OAuth Tokens ───────────────────────────────────────────────────
credentials.json
token.json
.env
*.env

# ── Output Logs & Summaries ──────────────────────────────────────────────────
*.log
latest_release_summary.txt

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
