# ─────────────────────────────────────────────────────────────────────────────
# Agentic Compliance Auditor — Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Set to "openai" to use standard OpenAI, or "azure" to use Azure OpenAI
AI_PROVIDER="openai"

# ── Standard OpenAI (used when AI_PROVIDER="openai") ─────────────────────────
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o"

# ── Azure OpenAI (used when AI_PROVIDER="azure") ─────────────────────────────
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE_NAME.openai.azure.com/"
AZURE_OPENAI_API_KEY="your_azure_openai_key_here"
AZURE_OPENAI_DEPLOYMENT_NAME="compliance-evaluator"
AZURE_OPENAI_API_VERSION="2024-02-01"
